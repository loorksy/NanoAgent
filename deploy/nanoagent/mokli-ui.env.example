# Copy to /opt/nanoagent/mokli-ui.env and chmod 600.
# Never commit the filled file. Generate MOKLI_SECRET_KEY once and keep it;
# rotating it logs every browser session out.
MOKLI_SECRET_KEY=
MOKLI_GATEWAY_URL=http://127.0.0.1:8766
MOKLI_API_TOKEN=
# Kasm desktop on the MT5 container's published port. The browser never sees these.
MT5_DESKTOP_URL=http://127.0.0.1:32768
MT5_DESKTOP_USER=
MT5_DESKTOP_PASSWORD=
