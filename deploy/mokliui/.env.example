# Copy to `.env` next to docker-compose.yml. Never commit the real file.

# ---- public address ----------------------------------------------------------------------
SITE_ADDRESS=mokli.lork.cloud
MOKLI_URL=https://mokli.lork.cloud
ACME_EMAIL=ops@lork.cloud
MOKLI_NAME=Mokli
# Arabic (Bahrain) as shipped by Mokli (src/lib/i18n/locales/ar-BH); `ar` is also available.
DEFAULT_LOCALE=ar-BH

# ---- Mokli secrets ------------------------------------------------------------------
# openssl rand -hex 32
MOKLI_SECRET_KEY=

# First run: keep true, register the operator (first account becomes admin), then set to false
# and run `docker compose up -d` again. Or fill the two MOKLI_ADMIN_* values for a headless
# bootstrap (sign-up is then disabled automatically after the admin is created).
ENABLE_SIGNUP=true
MOKLI_ADMIN_EMAIL=
MOKLI_ADMIN_PASSWORD=

# ---- mokli Agent API -------------------------------------------------------------------
# Long-lived token issued by mokli for the Mokli client (see docs/deploy/mokliui.md,
# "Obtaining the gateway token"). Used both as the OpenAI connection key and in the Pipe Valves.
MOKLI_API_TOKEN=
# Reached from inside the containers through host.docker.internal (Linux: host-gateway).
# The Mokli backend proxies /api/v1/mokli/* to this gateway. The browser never sees the token.
MOKLI_GATEWAY_URL=http://host.docker.internal:8766
OPENAI_API_BASE_URL=http://host.docker.internal:8766/v1
AGENT_API_UPSTREAM=host.docker.internal:8766
# `<function id>.<pipe id>` of the imported Pipe Function.
MOKLI_DEFAULT_MODEL=mokli.mokli
