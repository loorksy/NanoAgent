# Copy to `.env` next to docker-compose.yml. Never commit the real file.

# ---- public address ----------------------------------------------------------------------
SITE_ADDRESS=nanoagent.lork.cloud
WEBUI_URL=https://nanoagent.lork.cloud
ACME_EMAIL=ops@lork.cloud
WEBUI_NAME=NanoAgent
# Arabic (Bahrain) as shipped by Open WebUI (src/lib/i18n/locales/ar-BH); `ar` is also available.
DEFAULT_LOCALE=ar-BH

# ---- Open WebUI secrets ------------------------------------------------------------------
# openssl rand -hex 32
WEBUI_SECRET_KEY=

# First run: keep true, register the operator (first account becomes admin), then set to false
# and run `docker compose up -d` again. Or fill the two WEBUI_ADMIN_* values for a headless
# bootstrap (sign-up is then disabled automatically after the admin is created).
ENABLE_SIGNUP=true
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# ---- nanobot Agent API -------------------------------------------------------------------
# Long-lived token issued by nanobot for the Open WebUI client (see docs/deploy/openwebui.md,
# "Obtaining the gateway token"). Used both as the OpenAI connection key and in the Pipe Valves.
NANOAGENT_API_TOKEN=
# Reached from inside the containers through host.docker.internal (Linux: host-gateway).
# The Open WebUI backend proxies /api/v1/nanoagent/* to this gateway. The browser never sees the token.
NANOAGENT_GATEWAY_URL=http://host.docker.internal:8766
OPENAI_API_BASE_URL=http://host.docker.internal:8766/v1
AGENT_API_UPSTREAM=host.docker.internal:8766
# `<function id>.<pipe id>` of the imported Pipe Function.
NANOAGENT_DEFAULT_MODEL=nanoagent.nanoagent
