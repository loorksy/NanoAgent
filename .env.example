# OANDA market data (same credentials as foxagent production VPS)
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Self-hosted MT5 terminal via the mt5linux bridge (see README_DEPLOY.md).
# localhost is only the default — set MT5_HOST when the terminal is on another host.
MT5_HOST=localhost
MT5_PORT=8001
# Leave login, password, and server empty so the Connect page can save the account.
# If any of these is set, it overrides the saved account and the form cannot disconnect.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# systemd EnvironmentFile treats a backslash as an escape. Keep the doubled slashes.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_PORTABLE=1
MT5_IPC_TIMEOUT_MS=45000
# Optional
MT5_SYMBOL=XAUUSD
MT5_DEVIATION=20
MT5_TIMEOUT=10
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_SENTIMENT_MODEL=qwen2.5:3b
